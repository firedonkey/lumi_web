---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaLink from "../components/CtaLink.astro";
import { site } from "../config/site";
---

<BaseLayout title="Contact Lumi" description="Contact Lumi for product feedback, partnership ideas, pilot-home conversations, media questions, or investor introductions.">
  <section class="page-hero shell">
    <p class="eyebrow">Contact</p>
    <h1>Let’s talk about Lumi.</h1>
    <p class="lede">For product feedback, partnership ideas, pilot-home conversations, media questions, or investor introductions, reach out below.</p>
    <CtaLink href={`mailto:${site.contactEmail}`}>{site.contactEmail}</CtaLink>
  </section>
  <section class="section shell narrow">
    <div class="contact-panel">
      <p>Email</p>
      <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </div>
  </section>
</BaseLayout>
