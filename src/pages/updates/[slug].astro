---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { updates, getUpdateBySlug } from "../../content/updates";

export function getStaticPaths() {
  return updates.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { slug } = Astro.params;
const post = Astro.props.post ?? getUpdateBySlug(slug ?? "");
if (!post) {
  return Astro.redirect("/updates");
}
---

<BaseLayout title={`${post.title} | Lumi updates`} description={post.summary}>
  <article class="article shell">
    <a class="back-link" href="/updates">Back to updates</a>
    <div class="tag-row">{post.tags.map((tag) => <span>{tag}</span>)}</div>
    <h1>{post.title}</h1>
    <time datetime={post.date}>{new Date(`${post.date}T00:00:00`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</time>
    <p class="lede">{post.summary}</p>
    <div class="article-body">
      {post.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </article>
</BaseLayout>
